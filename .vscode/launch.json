{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Flask App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_DEBUG": "1"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open Chrome to localhost",
      "url": "http://localhost:5000",
      "webRoot": "${workspaceFolder}/app"
    }
  ]
}
